# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Python bytecode (benchmark / export tooling)
__pycache__/
*.py[cod]

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Evaluation run outputs (reports are regenerated by `npm run eval`)
eval/results/*
# ...except committed benchmark evidence (kept on purpose, not regenerated):
!eval/results/intel-xeon-e5-2678v3-concurrency/

# Playwright MCP test artifacts
.playwright-mcp/

# Smoke-test screenshots (regenerated by test runs; may contain rendered learner output)
exam-results-smoke.png

# Local secrets — never commit API keys
.env
.env.local
*.key

# OVMS prepared model graphs (large, user-generated); keep config.json
ovms/models/*/

# Python venv for ovms/tools/export_model.py (optimum-intel/openvino/torch —
# hundreds of MB, reinstall via ovms/tools/requirements-export.txt)
ovms/tools/.venv/

# Raw source textbook PDFs (large, third-party copyrighted scans downloaded by
# scripts/fetch-textbooks.ts) — never commit these. corpus/manifest.json (the
# scraped metadata) and corpus/out/ (derived ChunkDraft JSON) ARE committed.
corpus/raw/

# Cloudflare local secrets
.dev.vars
.wrangler/

# Local git worktrees (agent-managed isolated workspaces)
.worktrees/

# Data packs — derived from copyrighted textbooks, distributed separately
public/packs/*.pack.json

# Derived textbook chunks — not published
corpus/out/
