{
  "name": "pws-rag-edu",
  "private": true,
  "version": "0.0.0",
  "description": "Local-first, multilingual, adaptive RAG PWA for exam preparation and subject-based learning.",
  "license": "MIT",
  "homepage": "https://pws-rag-edu.pages.dev/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "cf:dev": "wrangler pages dev dist",
    "cf:deploy": "wrangler pages deploy dist",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx scripts/seed-packs.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "import:corpus": "tsx scripts/import-corpus.ts",
    "corpus:fetch": "tsx scripts/fetch-textbooks.ts",
    "corpus:ingest": "tsx scripts/ingest-pdf.ts",
    "exams:fetch": "tsx scripts/fetch-exam-papers.ts",
    "figures:extract": "tsx scripts/extract-figures.ts",
    "verify:embeddings": "tsx scripts/verify-embedding-space.ts",
    "eval": "tsx eval/runEval.ts",
    "eval:ci": "tsx eval/runEval.ts --gate --mode=deterministic",
    "eval:safety": "tsx eval/runSafetyEval.ts",
    "eval:rescue": "tsx eval/runRescueSensitivity.ts",
    "eval:sweep": "tsx eval/sweep.ts"
  },
  "dependencies": {
    "dexie": "^4.4.3",
    "i18next": "^26.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.16.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.0.7",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "pdfjs-dist": "^6.2.108",
    "tsx": "^4.22.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8",
    "wrangler": "^4.100.0"
  }
}
